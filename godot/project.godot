; Ashframe project configuration.
;
; `aurum new` wrote this file and nothing regenerates it afterwards, so it is
; safe to edit. The main scene, the physics rate and the rendering settings are
; the project's own; everything about the engine toolchain is in aurum.toml.

config_version=5

[application]

config/name="ASHFRAME"
config/description="Operation ASHEN YARD. A mech action game built on Aurum."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Aurum="*res://scripts/aurum_runtime.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/aurum/plugin.cfg", "res://addons/aurum_editor/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

[physics]

; The simulation runs at a fixed 120 Hz and is stepped from the physics tick.
; Matching the tick rate to it means one step per tick in the ordinary case,
; with no interpolation between them to disagree about where anything is.
common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method.mobile="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.5, 0.52, 0.55, 1)
textures/vram_compression/import_etc2_astc=true
